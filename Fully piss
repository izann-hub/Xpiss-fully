local function CreateRipple(button, input)
    button.ClipsDescendants = true
    local ripple = Instance.new("Frame")
    ripple.BackgroundColor3 = Pallete.Purple
    ripple.BackgroundTransparency = 0.5
    ripple.BorderSizePixel = 0
    ripple.Size = UDim2.new(0, 0, 0, 0)
    ripple.ZIndex = button.ZIndex - 1
    Instance.new("UICorner", ripple).CornerRadius = UDim.new(1, 0)
    
    local posX = input.Position.X - button.AbsolutePosition.X
    local posY = input.Position.Y - button.AbsolutePosition.Y
    ripple.Position = UDim2.new(0, posX, 0, posY)
    ripple.AnchorPoint = Vector2.new(0.5, 0.5)
    ripple.Parent = button
    
    local targetSize = math.max(button.AbsoluteSize.X, button.AbsoluteSize.Y) * 2
    TweenService:Create(ripple, TweenInfo.new(0.5, Enum.EasingStyle.Quint), {
        Size = UDim2.new(0, targetSize, 0, targetSize), BackgroundTransparency = 1
    }):Play()
    task.delay(0.5, function() if ripple then ripple:Destroy() end end)
end

